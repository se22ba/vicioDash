# Variables del backend. No incluyas este archivo con valores reales en Git.
# En Render, configurarlas desde Environment. En local, exportarlas en la terminal.
ADMIN_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
DATA_PATH=./data/vicio.sqlite
# Para Render Free, usar una base PostgreSQL externa; SQLite local es efímero allí.
DATABASE_URL=
# El Blueprint fija true para impedir arranque sin almacenamiento persistente.
REQUIRE_DATABASE_URL=false
PORT=8000
# Opcionales para carga manual; ambos requeridos para iniciar el bot:
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Vacío: todos los miembros humanos del servidor. O IDs separados por coma.
WATCH_USER_IDS=

# Opcional: canal fijo para actividad de micrófono; también se configura desde el tablero.
VOICE_CHANNEL_ID=
